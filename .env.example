# ============================================================================
# ORION — modèle de configuration.  Copier en .env et renseigner.
# ============================================================================
# Les valeurs réelles ne vivent JAMAIS dans le dépôt : .env, appsettings.json et
# appsettings.Development.json sont tous gitignorés.
#
# En production ces valeurs arrivent par variables d'environnement. Le double
# souligné correspond à l'imbrication .NET : Auth__JwtSecret => section "Auth",
# clé "JwtSecret".  Voir docs/deployment.md.
# ============================================================================

# ---------------------------------------------------------------------------
# Base de données — PostgreSQL + pgvector
# ---------------------------------------------------------------------------
ConnectionStrings__Supabase=Host=db.xxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=xxx;SSL Mode=Require

# ---------------------------------------------------------------------------
# Authentification — FAIL-CLOSED
# Absentes ou trop faibles : la connexion est REFUSÉE (503). Ce n'est pas une
# panne, c'est le comportement voulu.
# ---------------------------------------------------------------------------
Auth__Password=                       # mot de passe unique du propriétaire
Auth__JwtSecret=                      # 32 caractères minimum
Auth__TokenLifetimeDays=30

# Secret partagé backend <-> daemon. Vide => WebSocket daemon REFUSÉ.
# La même valeur doit être posée côté daemon (Daemon:Token).
DAEMON_WS_TOKEN=

# ---------------------------------------------------------------------------
# Origines autorisées — CORS *et* WebSocket, même source de vérité.
# ⚠️ Liste VIDE = le framework accepte TOUTE origine : l'application REFUSE
# alors de démarrer, plutôt que de tourner grand ouverte sans que ça se voie.
# ---------------------------------------------------------------------------
AllowedOrigins__0=http://localhost:5173

# ---------------------------------------------------------------------------
# Cerveau distant — NVIDIA NIM (compatible OpenAI). Premier de la cascade.
# ---------------------------------------------------------------------------
Nim__BaseUrl=https://integrate.api.nvidia.com/v1
Nim__ApiKey=
Nim__Model=nvidia/nemotron-3-super-120b-a12b
Nim__TimeoutSeconds=120

# ---------------------------------------------------------------------------
# Cerveau local — Ollama. Dernier de la cascade : repli hors-ligne, dégradé.
# Optionnel : sans lui, ORION perd seulement son mode hors-ligne.
#
# ⚠️ NumCtx est OBLIGATOIRE. Sans elle, Ollama dimensionne le cache KV sur le
# contexte maximum du modèle (128k) et réclame ~15 Go pour un modèle de 2 Go
# — HTTP 500 intermittents, sans message utile.
# ---------------------------------------------------------------------------
Ollama__BaseUrl=http://localhost:11434
Ollama__Model=llama3.2:3b
Ollama__NumCtx=8192
Ollama__TimeoutSeconds=120

# ---------------------------------------------------------------------------
# Embeddings — fournisseur compatible OpenAI.
# ⚠️ NE BASCULE PAS à chaud : chaque modèle projette dans son propre espace
# vectoriel. Changer de fournisseur impose de revectoriser toute la table
# (POST /api/memory/revectorize). Dimensions doit correspondre EXACTEMENT à
# la colonne memory_vectors.embedding.
# ---------------------------------------------------------------------------
Embedding__BaseUrl=https://api.mistral.ai/v1
Embedding__ApiKey=
Embedding__Model=mistral-embed
Embedding__Dimensions=1024

# ---------------------------------------------------------------------------
# Transcription — distant en tête, Whisper local en repli.
# Si vide, retombe automatiquement sur Embedding__ApiKey (même fournisseur,
# même compte : dupliquer le secret créerait deux valeurs à faire tourner
# ensemble, et une seule finirait par l'être).
# ---------------------------------------------------------------------------
Transcription__BaseUrl=https://api.mistral.ai/v1
Transcription__ApiKey=
Transcription__TimeoutSeconds=60

# ---------------------------------------------------------------------------
# Recherche web — DuckDuckGo ne demande aucune clé.
# ---------------------------------------------------------------------------
Internet__SearchApiProvider=duckduckgo
Internet__BraveApiKey=
Internet__SerpApiKey=
Internet__MaxResults=5
